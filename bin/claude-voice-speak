#!/usr/bin/env bash
# Text-to-speech using edge-tts (Microsoft Neural) with mpv
# Usage: claude-voice-speak "texto a hablar"

VOICE="${CLAUDE_VOICE_TTS_VOICE:-es-MX-DaliaNeural}"
AUDIO="/tmp/.claude-voice-tts.mp3"
VENV_EDGE="${HOME}/Proyectos/claude-voice/venv/bin/edge-tts"

TEXT="$*"
[[ -z "$TEXT" ]] && exit 0

# Strip markdown: remove **, *, #, `, backtick blocks, bullet dashes
CLEAN=$(echo "$TEXT" | python3 -c "
import sys, re
t = sys.stdin.read()
t = re.sub(r'\`\`\`.*?\`\`\`', '', t, flags=re.DOTALL)
t = re.sub(r'\`[^\`]+\`', lambda m: m.group().strip('\`'), t)
t = re.sub(r'[*_]{1,3}([^*_]+)[*_]{1,3}', r'\1', t)
t = re.sub(r'^#{1,6}\s+', '', t, flags=re.MULTILINE)
t = re.sub(r'^\s*[-*+]\s+', '', t, flags=re.MULTILINE)
t = re.sub(r'\[([^\]]+)\]\([^\)]+\)', r'\1', t)
t = re.sub(r'\n{2,}', '. ', t)
t = t.replace('\n', ' ').strip()
print(t)
")

"$VENV_EDGE" \
    --voice "$VOICE" \
    --text "$CLEAN" \
    --write-media "$AUDIO" \
    2>/dev/null \
&& mpv --no-terminal --really-quiet "$AUDIO" 2>/dev/null
